# ============================================================
# Story Puzzle Solver — configuration
# Copy to .env and adjust. Times are LOCAL 24h (HH:MM).
# ============================================================

# --- Competition window (rule 5) ---
COMPETITION_START=22:50
EXPECTED_EVENT_TIME=23:00
COMPETITION_END=23:30

# --- Polling ---
POLL_INTERVAL_MS=250

# --- Video sampling (rule 12) ---
VIDEO_INITIAL_SAMPLE_MS=300
VIDEO_FOCUSED_SAMPLE_MS=75
VIDEO_MAX_FRAMES=400

# --- Engines ---
OCR_ENABLED=true
VISION_ENABLED=true
OCR_WORKERS=2
VISION_WORKERS=1

# --- Card normalization (rule 16) ---
CARD_WIDTH=1024
CARD_HEIGHT=640

# --- Cache ---
CACHE_ENABLED=true

# --- Notifications (rule 39: Windows only; stub used off-Windows) ---
WINDOWS_NOTIFICATIONS=true

# --- Modes ---
SIMULATION=true
DEBUG_MODE=false

# --- OCR ---
OCR_CONFIDENCE_HIGH=0.90
OCR_CONFIDENCE_MEDIUM=0.70
OCR_DIGIT_WHITELIST=0123456789
OCR_MIN_CONFIRMATIONS=2

# --- Notification threshold ---
NOTIFY_MIN_CONFIDENCE=0.75

# --- Storage ---
STATE_DIR=.state
LOG_DIR=.logs

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# --- Browser story source (Option 2, --source browser) ---
# Username whose stories to watch (REQUIRED for browser mode)
SNAP_TARGET_USERNAME=
# Persistent browser profile dir (keeps your Snapchat session between runs)
SNAP_BROWSER_PROFILE=.browser-profile
# Show browser window (false = visible, for manual login on first run)
SNAP_HEADLESS=false
# Seconds to wait for manual login on first run
SNAP_LOGIN_WAIT_SEC=60
# Page navigation timeout (ms)
SNAP_NAV_TIMEOUT_MS=15000
# Auto-click story tiles (true/false)
SNAP_STORY_OPEN=true

# --- Folder story source (Option 1, --source folder) ---
# Folder watched for user-dropped media (image/video)
WATCH_DIR=fixtures/watch
